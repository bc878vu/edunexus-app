{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://www.googletagservices.com https://*.gstatic.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://*.googleadservices.com https://*.doubleclick.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.googleapis.com wss://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.supabase.co https://*.google-analytics.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.googleadservices.com https://*.cloudinary.com https://*.vercel-insights.com; frame-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com https://drive.google.com https://docs.google.com https://*.firebaseapp.com https://accounts.google.com https://*.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.googleadservices.com https://cprpndovdfnkvekewstv.supabase.co https://res.cloudinary.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/learning/:code/:slug",
      "destination": "/api/learning-page?code=:code&slug=:slug"
    },
    {
      "source": "/articles/read/:id/:slug",
      "destination": "/api/article-page?id=:id&slug=:slug"
    },
    {
      "source": "/articles-sitemap.xml",
      "destination": "/api/article-sitemap"
    },
    {
      "source": "/subjects-sitemap.xml",
      "destination": "/api/subjects-sitemap"
    },
    {
      "source": "/resource-sitemap.xml",
      "destination": "/api/resource-sitemap"
    },
    {
      "source": "/vu-notes/file/:id",
      "destination": "/api/resource-page?id=:id"
    },
    {
      "source": "/vu-notes/file/:id/:slug",
      "destination": "/api/resource-page?id=:id&slug=:slug"
    },
    {
      "source": "/vu-notes",
      "destination": "/index.html"
    },
    {
      "source": "/handouts",
      "destination": "/index.html"
    },
    {
      "source": "/past-papers",
      "destination": "/index.html"
    },
    {
      "source": "/quizzes",
      "destination": "/index.html"
    },
    {
      "source": "/cgpa-calculator",
      "destination": "/index.html"
    },
    {
      "source": "/ai-tools",
      "destination": "/index.html"
    },
    {
      "source": "/articles",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/study-guides",
      "destination": "/index.html"
    },
    {
      "source": "/vu-notes-guide",
      "destination": "/index.html"
    },
    {
      "source": "/past-papers-guide",
      "destination": "/index.html"
    },
    {
      "source": "/exam-preparation",
      "destination": "/index.html"
    },
    {
      "source": "/cgpa-guide",
      "destination": "/index.html"
    },
    {
      "source": "/ai-study-tools",
      "destination": "/index.html"
    },
    {
      "source": "/student-resources",
      "destination": "/index.html"
    },
    {
      "source": "/live-projects",
      "destination": "/index.html"
    },
    {
      "source": "/tutorials",
      "destination": "/index.html"
    },
    {
      "source": "/forum",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/academic/:subject",
      "destination": "/index.html"
    },
    {
      "source": "/exam-prep/:subject/:term/:section",
      "destination": "/api/resource-page?examprep=1&section=:section&subject=:subject&term=:term"
    },
    {
      "source": "/exam-prep/:subject/:term",
      "destination": "/index.html"
    },
    {
      "source": "/exam-prep",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}