{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/learning/:code/:slug",
      "destination": "/api/learning-page?code=:code&slug=:slug"
    },
    {
      "source": "/articles/read/:id/:slug",
      "destination": "/api/article-page?id=:id&slug=:slug"
    },
    {
      "source": "/articles-sitemap.xml",
      "destination": "/api/article-sitemap"
    },
    {
      "source": "/resource-sitemap.xml",
      "destination": "/api/resource-sitemap"
    },
    {
      "source": "/vu-notes/file/:id/:slug",
      "destination": "/api/resource-page?id=:id&slug=:slug"
    },
    {
      "source": "/vu-notes",
      "destination": "/index.html"
    },
    {
      "source": "/handouts",
      "destination": "/index.html"
    },
    {
      "source": "/past-papers",
      "destination": "/index.html"
    },
    {
      "source": "/quizzes",
      "destination": "/index.html"
    },
    {
      "source": "/cgpa-calculator",
      "destination": "/index.html"
    },
    {
      "source": "/ai-tools",
      "destination": "/index.html"
    },
    {
      "source": "/articles",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/study-guides",
      "destination": "/index.html"
    },
    {
      "source": "/vu-notes-guide",
      "destination": "/index.html"
    },
    {
      "source": "/past-papers-guide",
      "destination": "/index.html"
    },
    {
      "source": "/exam-preparation",
      "destination": "/index.html"
    },
    {
      "source": "/cgpa-guide",
      "destination": "/index.html"
    },
    {
      "source": "/ai-study-tools",
      "destination": "/index.html"
    },
    {
      "source": "/student-resources",
      "destination": "/index.html"
    },
    {
      "source": "/live-projects",
      "destination": "/index.html"
    },
    {
      "source": "/tutorials",
      "destination": "/index.html"
    },
    {
      "source": "/forum",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
