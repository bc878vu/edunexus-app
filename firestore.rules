// EduNexus Firestore rules — console publish version 2026-09-28 (complete: article likes + paperName/paperPath/paperUrl admin update)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin access is tied to the Firebase account, not a client-side password.
    // Email verification is required before any privileged write is accepted.
    function admin() {
      // Email verification is NOT required: the admin signs in with a
      // password, so the verified email + password combination is the gate.
      // Requiring the verified flag locked the admin out when Firebase's
      // verification emails don't arrive.
      return signedIn()
        && request.auth.token.email == 'veducator4@gmail.com';
    }

    match /artifacts/edunexus-live/public/data/announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/articles/{docId} {
      allow read: if true;
      allow create, delete: if admin();
      // Signed-in readers may like an article: the ONLY permitted change is
      // likes +1 together with their own uid appended to likedBy.
      allow update: if admin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        && request.resource.data.get('likes', 0) == resource.data.get('likes', 0) + 1
        && !(request.auth.uid in resource.data.get('likedBy', []))
        && request.auth.uid in request.resource.data.get('likedBy', [])
      );
    }

    // Facebook-style comments on articles. Anyone can read; signed-in users
    // may post as themselves, edit/delete their own, admins moderate all.
    match /artifacts/edunexus-live/public/data/articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','userName','text','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      // Owner may only change the text (and the timestamp); admin may do anything.
      // updateComment has no live callers (src/db/articles.js:310) — this only
      // constrains direct Firestore API calls. No 'isActive' field exists on
      // comments (COMMENT_SPEC: userId, userName, text, parentCommentId,
      // createdAt, updatedAt); updatedAt is optional because the fallback
      // passes data through raw without adding it.
      allow update: if admin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time));
      allow delete: if admin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /artifacts/edunexus-live/public/data/highlights/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/files/{docId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin();
      // Ratings are computed server-side only (Supabase DB trigger on
      // file_reviews — the live path; see supabase-f3-f4-f6.sql Part 4).
      // Clients may not write the summary fields: bounds alone cannot
      // prove the numbers match the approved reviews.
    }

    match /artifacts/edunexus-live/public/data/tutorials/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/pinned_ads/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/discussions/{docId} {
      allow read: if true;
      // A signed-in user may create only a post owned by their own UID.
      // Field list = the legacy Firestore writer (removed in Phase 2,
      // commit 3935e23): content, createdAt (serverTimestamp), userId,
      // userName, userEmail. No live client writes Firestore discussions
      // (Supabase-only since Phase 2); this only constrains direct API
      // calls and old cached bundles. 'title' is permitted (in
      // DISCUSSION_SPEC) though the legacy writer never sent it.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','userName','userEmail','title','content','createdAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && (!('userEmail' in request.resource.data) || (request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 160))
        && request.resource.data.createdAt == request.time;
      // Owners may edit/delete their own post; they cannot transfer ownership.
      // affectedKeys (not hasOnly on the merged doc) so admin-set fields
      // (pinned/adminReply/isActive) don't block later owner edits, while
      // the owner still cannot change them. updatedAt is optional because
      // the legacy update branch passed data through raw.
      allow update: if admin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content','title','userName','userEmail','updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time));
      allow delete: if admin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Private one-report-per-account abuse queue for public forum posts.
    match /artifacts/edunexus-live/public/data/discussions/{postId}/reports/{reporterId} {
      allow get: if admin() || (signedIn() && reporterId == request.auth.uid);
      allow list: if admin();
      allow create: if signedIn()
        && reporterId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/discussions/$(postId))
        && get(/databases/$(database)/documents/artifacts/edunexus-live/public/data/discussions/$(postId)).data.userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid','reason','createdAt'])
        && request.resource.data.keys().hasAll(['reporterUid','reason','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam','abuse','copyright','personal-data','other']
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    // Student test-paper attempts: a signed-in student (anonymous included)
    // may create only their own attempt and read only their own doc; only
    // the admin may list all attempts or save teacher marks.
    // Field list = the legacy Firestore writer (removed in commit 544a8d5):
    // TestPaper payload (userId, studentName, studentVuId, paperSlug,
    // paperCode, mcqAnswers, mcqScore, mcqTotal, shortAnswers, longAnswers,
    // paperSnapshot?) + status/teacherMarks/teacherFeedback/createdAt/
    // updatedAt (both serverTimestamp). No live client writes Firestore
    // attempts (Supabase-only since 544a8d5); this only constrains direct
    // API calls and old cached bundles. There is no 'course'/'examTerm'
    // field, so validCourse/validExamTerm do not apply here.
    match /artifacts/edunexus-live/public/data/paperAttempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','studentName','studentVuId','paperSlug','paperCode','mcqAnswers','mcqScore','mcqTotal','shortAnswers','longAnswers','paperSnapshot','status','teacherMarks','teacherFeedback','createdAt','updatedAt'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() > 0 && request.resource.data.studentName.size() <= 100
        && request.resource.data.studentVuId is string && request.resource.data.studentVuId.size() <= 30
        && request.resource.data.paperSlug is string && request.resource.data.paperSlug.size() <= 120
        && request.resource.data.paperCode is string && request.resource.data.paperCode.size() <= 20
        && request.resource.data.mcqAnswers is map
        && request.resource.data.mcqScore is int && request.resource.data.mcqScore >= 0
        && request.resource.data.mcqTotal is int && request.resource.data.mcqTotal >= 0
        && request.resource.data.mcqScore <= request.resource.data.mcqTotal
        && request.resource.data.shortAnswers is list
        && request.resource.data.longAnswers is list
        && (!('paperSnapshot' in request.resource.data) || request.resource.data.paperSnapshot is map)
        && request.resource.data.status == 'submitted'
        && request.resource.data.teacherMarks == null
        && request.resource.data.teacherFeedback == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if admin();
      allow update: if admin();
      allow delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/feedback/{docId} {
      // Two real writers, union of both shapes (FEEDBACK_SPEC):
      // (a) live exam-review report — src/ExamPaperCommunity.js:199, direct
      //     Firestore addDoc: userId, category, reviewId, reviewCollection,
      //     reason, createdAt: serverTimestamp().
      // (b) contact form via old cached bundles — src/App.js:1911 passes
      //     {name, email, msg, createdAt: new Date()} through the pre-Phase 2
      //     fallback, which wrote it to Firestore verbatim. new Date() is a
      //     CLIENT timestamp, so createdAt must be `is timestamp`, NOT
      //     `== request.time`, or old cached contact forms break.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId','category','reviewId','reviewCollection','reason','name','email','msg','createdAt'])
        && request.resource.data.createdAt is timestamp
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        && (('msg' in request.resource.data) || ('reason' in request.resource.data))
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 2000))
        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 2000))
        && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 80))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (!('reviewId' in request.resource.data) || (request.resource.data.reviewId is string && request.resource.data.reviewId.size() <= 200))
        && (!('reviewCollection' in request.resource.data) || (request.resource.data.reviewCollection is string && request.resource.data.reviewCollection.size() <= 200));
      allow read, update, delete: if admin();
    }

    // Kept public because the existing portfolio/profile page reads this
    // document. Do not store private credentials or sensitive personal data here.
    match /artifacts/edunexus-live/public/data/profile/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Public site configuration is readable by the dashboard; only the verified
    // admin can change it.
    match /artifacts/edunexus-live/public/data/meta/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Private per-user data is isolated by authenticated UID.
    match /artifacts/edunexus-live/users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Published educational questions: public read, verified-admin writes only.
    function validCourse(code) {
      return code is string && code.matches('^[A-Z]{2,5}[0-9]{3}[A-Z]?$');
    }

    function validExamTerm(term) {
      return term in ['midterm', 'finalterm'];
    }

    match /artifacts/edunexus-live/public/data/examMcqs/{questionId} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          'subject', 'term', 'question', 'options', 'answer', 'explanation', 'importBatchId', 'sourceFileName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['importBatchId', 'sourceFileName'])
        && request.resource.data.importBatchId is string
        && request.resource.data.importBatchId.size() > 0
        && request.resource.data.importBatchId.size() <= 80
        && request.resource.data.sourceFileName is string
        && request.resource.data.sourceFileName.size() > 0
        && request.resource.data.sourceFileName.size() <= 120
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 1000
        && request.resource.data.options is list
        && request.resource.data.options.size() == 4
        && request.resource.data.options[0] is string
        && request.resource.data.options[1] is string
        && request.resource.data.options[2] is string
        && request.resource.data.options[3] is string
        && request.resource.data.answer is int
        && request.resource.data.answer >= 0
        && request.resource.data.answer <= 3
        && request.resource.data.explanation is string
        && request.resource.data.explanation.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }

    // Student submissions remain private until an administrator approves them.
    // Deterministic review IDs prevent one student overwriting another student's work.
    match /artifacts/edunexus-live/public/data/examReviewSubmissions/{reviewId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'examDate', 'difficulty', 'topics',
          'summary', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && reviewId.matches('^' + request.auth.uid + '_' + request.resource.data.subject
          + '_' + request.resource.data.term + '_' + request.resource.data.examDate + '(_[a-z0-9]+)?$')
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 10000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get: if admin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if admin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/examReviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Completed-exam experiences publish immediately; legacy reviews are preserved.
    // Deterministic IDs limit duplicates per UID/course/term/date but do not
    // replace App Check, abuse monitoring or a shared rate limiter.
    match /artifacts/edunexus-live/public/data/examCommunityReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt',
          'paperName', 'paperPath', 'paperUrl'
        ])
        // Paper attachments are optional; a plain-text review must be valid.
        && request.resource.data.keys().hasAll([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.semester is string
        && request.resource.data.semester.matches('^(Spring|Fall|Summer) 20[0-9]{2}$')
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.examTime is string
        && request.resource.data.examTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.examAt is timestamp
        && request.resource.data.examAt <= request.time
        && reviewId.matches('^' + request.auth.uid + '_' + request.resource.data.subject
          + '_' + request.resource.data.term + '_' + request.resource.data.examDate + '(_[a-z0-9]+)?$')
        && request.resource.data.sharedBy is string
        && request.resource.data.sharedBy.size() >= 2
        && request.resource.data.sharedBy.size() <= 60
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 10000
        && request.resource.data.createdAt == request.time
        && (
          !request.resource.data.keys().hasAny(['paperName', 'paperPath', 'paperUrl'])
          || (
            request.resource.data.keys().hasAll(['paperName', 'paperPath', 'paperUrl'])
            && request.resource.data.paperName is string
            && request.resource.data.paperName.matches('^[A-Za-z0-9._-]{1,95}$')
            && request.resource.data.paperPath is string
            && request.resource.data.paperPath.matches('^exam-papers/' + request.resource.data.userId + '/[a-z0-9_]{8,32}/[A-Za-z0-9._-]{1,95}$')
            && request.resource.data.paperUrl is string
            && request.resource.data.paperUrl.matches('^https://firebasestorage.googleapis.com/v0/b/edunexus-live-e0b84[.]firebasestorage[.]app/o/.*$')
          )
        );
      // Authenticated students cannot rewrite public content; admin can remove it.
      // Students cannot edit public reviews. Admins can fix public content
      // without changing the author's UID or the original publication date.
      allow update: if admin()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt',
          'paperName', 'paperPath', 'paperUrl'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.semester is string
        && request.resource.data.semester.matches('^(Spring|Fall|Summer) 20[0-9]{2}$')
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.examTime is string
        && request.resource.data.examTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.examAt is timestamp
        && request.resource.data.examAt <= request.time
        && request.resource.data.sharedBy is string
        && request.resource.data.sharedBy.size() >= 2
        && request.resource.data.sharedBy.size() <= 60
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 10000
        && (
          !request.resource.data.keys().hasAny(['paperName', 'paperPath', 'paperUrl'])
          || (
            request.resource.data.keys().hasAll(['paperName', 'paperPath', 'paperUrl'])
            && request.resource.data.paperName is string
            && request.resource.data.paperName.matches('^[A-Za-z0-9._-]{1,95}$')
            && request.resource.data.paperPath is string
            && request.resource.data.paperPath.matches('^exam-papers/' + request.resource.data.userId + '/[a-z0-9_]{8,32}/[A-Za-z0-9._-]{1,95}$')
            && request.resource.data.paperUrl is string
            && request.resource.data.paperUrl.matches('^https://firebasestorage.googleapis.com/v0/b/edunexus-live-e0b84[.]firebasestorage[.]app/o/.*$')
          )
        );
      allow delete: if admin();
    }

    // A student can create only one genuine, immediately public review per file.
    // The immutable originalComment retains the author's submitted text when
    // an administrator later edits the displayed comment. Legacy records remain.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId} {
      allow get: if admin()
        || (signedIn() && reviewId == request.auth.uid)
        || resource.data.status == 'approved';
      // Public list queries must include where('status', '==', 'approved').
      allow list: if admin() || resource.data.status == 'approved';
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId))
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'comment', 'originalComment', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'rating', 'comment', 'originalComment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 50000
        && request.resource.data.originalComment == request.resource.data.comment
        && request.resource.data.status == 'approved'
        && request.resource.data.createdAt == request.time;

      // Admin text/rating corrections preserve the original submission and UID.
      allow update: if admin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'comment', 'editedAt'
        ])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 50000
        && request.resource.data.editedAt == request.time;
      // Historical pending reviews may still be published or rejected by admin.
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatedAt'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedAt == request.time;
      allow delete: if admin();
    }

    // Report abuse without changing or hiding an existing public review.
    // Each signed-in Firebase UID may report another user's review once.
    // Reports are private and visible only to the verified administrator and
    // the reporter's own exact record. No user can list other people's reports.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId}/reports/{reporterId} {
      allow get: if admin() || (signedIn() && reporterId == request.auth.uid);
      allow list: if admin();
      allow create: if signedIn()
        && reporterId == request.auth.uid
        && reviewId != request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId)/reviews/$(reviewId))
        && request.resource.data.keys().hasOnly(['reporterUid','reason','createdAt'])
        && request.resource.data.keys().hasAll(['reporterUid','reason','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam','abuse','copyright','personal-data','other']
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    // All other Firestore paths remain denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
