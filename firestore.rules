rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin access is tied to the Firebase account, not a client-side password.
    // Email verification is required before any privileged write is accepted.
    function admin() {
      return signedIn()
        && request.auth.token.email == 'veducator4@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /artifacts/edunexus-live/public/data/announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/articles/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/highlights/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/files/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/tutorials/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/discussions/{docId} {
      allow read: if true;
      // A signed-in user may create only a post owned by their own UID.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      // Owners may edit/delete their own post; they cannot transfer ownership.
      allow update: if admin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);
      allow delete: if admin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /artifacts/edunexus-live/public/data/feedback/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if admin();
    }

    // Kept public because the existing portfolio/profile page reads this
    // document. Do not store private credentials or sensitive personal data here.
    match /artifacts/edunexus-live/public/data/profile/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Public site configuration is readable by the dashboard; only the verified
    // admin can change it.
    match /artifacts/edunexus-live/public/data/meta/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Private per-user data is isolated by authenticated UID.
    match /artifacts/edunexus-live/users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Published educational questions: public read, verified-admin writes only.
    function validCourse(code) {
      return code is string && code.matches('^[A-Z]{2,5}[0-9]{3}[A-Z]?$');
    }

    function validExamTerm(term) {
      return term in ['midterm', 'finalterm'];
    }

    match /artifacts/edunexus-live/public/data/examMcqs/{questionId} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          'subject', 'term', 'question', 'options', 'answer', 'explanation', 'createdAt'
        ])
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 1000
        && request.resource.data.options is list
        && request.resource.data.options.size() == 4
        && request.resource.data.options[0] is string
        && request.resource.data.options[1] is string
        && request.resource.data.options[2] is string
        && request.resource.data.options[3] is string
        && request.resource.data.answer is int
        && request.resource.data.answer >= 0
        && request.resource.data.answer <= 3
        && request.resource.data.explanation is string
        && request.resource.data.explanation.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }

    // Student submissions remain private until an administrator approves them.
    // Deterministic review IDs prevent one student overwriting another student's work.
    match /artifacts/edunexus-live/public/data/examReviewSubmissions/{reviewId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'examDate', 'difficulty', 'topics',
          'summary', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && reviewId == request.auth.uid + '_' + request.resource.data.subject
          + '_' + request.resource.data.term + '_' + request.resource.data.examDate
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 1500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get: if admin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if admin();
      allow update, delete: if admin();
    }

    match /artifacts/edunexus-live/public/data/examReviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Completed-exam experiences publish immediately; legacy reviews are preserved.
    // Deterministic IDs limit duplicates per UID/course/term/date but do not
    // replace App Check, abuse monitoring or a shared rate limiter.
    match /artifacts/edunexus-live/public/data/examCommunityReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.semester is string
        && request.resource.data.semester.matches('^(Spring|Fall|Summer) 20[0-9]{2}$')
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.examTime is string
        && request.resource.data.examTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.examAt is timestamp
        && request.resource.data.examAt <= request.time
        && reviewId == request.auth.uid + '_' + request.resource.data.subject
          + '_' + request.resource.data.term + '_' + request.resource.data.examDate
        && request.resource.data.sharedBy is string
        && request.resource.data.sharedBy.size() >= 2
        && request.resource.data.sharedBy.size() <= 60
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 1500
        && request.resource.data.createdAt == request.time;
      // Student posts remain immutable to their authors. Verified admins can
      // correct public reviews but may not transfer ownership or alter origin.
      allow update: if admin()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'term', 'semester', 'examDate', 'examTime',
          'examAt', 'sharedBy', 'difficulty', 'topics', 'summary', 'createdAt'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && validCourse(request.resource.data.subject)
        && validExamTerm(request.resource.data.term)
        && request.resource.data.semester is string
        && request.resource.data.semester.matches('^(Spring|Fall|Summer) 20[0-9]{2}
    }

    // Moderated reviews belong to the existing Academic Hub file documents.
    // Subcollection rules are independent of the parent file's admin-only writes.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId} {
      // Approved reviews are public; only the owner or admin can view a draft.
      // Public list queries must filter with where('status', '==', 'approved').
      allow get: if admin()
        || (signedIn() && reviewId == request.auth.uid)
        || resource.data.status == 'approved';
      allow list: if admin() || resource.data.status == 'approved';

      // One pending review per Firebase user per file. Anonymous Firebase
      // sessions still have a UID; draft reviews are not publicly listed.
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId))
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'comment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 800
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Moderation never changes the author, rating or original review text.
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'moderatedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedAt == request.time;
      allow delete: if admin();
    }

    // All other Firestore paths remain denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.examDate is string
        && request.resource.data.examDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}
    }

    // Moderated reviews belong to the existing Academic Hub file documents.
    // Subcollection rules are independent of the parent file's admin-only writes.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId} {
      // Approved reviews are public; only the owner or admin can view a draft.
      // Public list queries must filter with where('status', '==', 'approved').
      allow get: if admin()
        || (signedIn() && reviewId == request.auth.uid)
        || resource.data.status == 'approved';
      allow list: if admin() || resource.data.status == 'approved';

      // One pending review per Firebase user per file. Anonymous Firebase
      // sessions still have a UID; draft reviews are not publicly listed.
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId))
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'comment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 800
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Moderation never changes the author, rating or original review text.
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'moderatedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedAt == request.time;
      allow delete: if admin();
    }

    // All other Firestore paths remain denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.examTime is string
        && request.resource.data.examTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]
    }

    // Moderated reviews belong to the existing Academic Hub file documents.
    // Subcollection rules are independent of the parent file's admin-only writes.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId} {
      // Approved reviews are public; only the owner or admin can view a draft.
      // Public list queries must filter with where('status', '==', 'approved').
      allow get: if admin()
        || (signedIn() && reviewId == request.auth.uid)
        || resource.data.status == 'approved';
      allow list: if admin() || resource.data.status == 'approved';

      // One pending review per Firebase user per file. Anonymous Firebase
      // sessions still have a UID; draft reviews are not publicly listed.
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId))
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'comment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 800
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Moderation never changes the author, rating or original review text.
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'moderatedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedAt == request.time;
      allow delete: if admin();
    }

    // All other Firestore paths remain denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.examAt is timestamp
        && request.resource.data.examAt <= request.time
        && request.resource.data.sharedBy is string
        && request.resource.data.sharedBy.size() >= 2
        && request.resource.data.sharedBy.size() <= 60
        && request.resource.data.difficulty in ['easy', 'moderate', 'challenging']
        && request.resource.data.topics is string
        && request.resource.data.topics.size() <= 400
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 1500;
      allow delete: if admin();
    }

    // Moderated reviews belong to the existing Academic Hub file documents.
    // Subcollection rules are independent of the parent file's admin-only writes.
    match /artifacts/edunexus-live/public/data/files/{fileId}/reviews/{reviewId} {
      // Approved reviews are public; only the owner or admin can view a draft.
      // Public list queries must filter with where('status', '==', 'approved').
      allow get: if admin()
        || (signedIn() && reviewId == request.auth.uid)
        || resource.data.status == 'approved';
      allow list: if admin() || resource.data.status == 'approved';

      // One pending review per Firebase user per file. Anonymous Firebase
      // sessions still have a UID; draft reviews are not publicly listed.
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && exists(/databases/$(database)/documents/artifacts/edunexus-live/public/data/files/$(fileId))
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'comment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 20
        && request.resource.data.comment.size() <= 800
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Moderation never changes the author, rating or original review text.
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'moderatedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedAt == request.time;
      allow delete: if admin();
    }

    // All other Firestore paths remain denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
